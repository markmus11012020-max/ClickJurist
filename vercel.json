{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix landing",
  "buildCommand": "npm run build --prefix landing",
  "outputDirectory": "landing/dist",
  "framework": null,
  "rewrites": [
    { "source": "/payment/(.*)", "destination": "/payment/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
