# OpenRouter API — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Модели ИИ-каскада
GENERATOR_MODEL=deepseek/deepseek-chat
EDITOR_MODEL=google/gemini-2.5-pro-preview

# ЮKassa — https://yookassa.ru (самозанятый / ИП)
# 1. Создайте магазин → скопируйте shopId и secretKey
# 2. Webhook URL: https://api.clickjurist.ru/api/v1/payments/webhook
# 3. Событие: payment.succeeded
# 4. Return URL: https://clickjurist.ru/payment/success.html
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
FRONTEND_REDIRECT_URL=https://clickjurist.ru/payment/success.html

# Сервер
PORT=3001
NODE_ENV=production

# CORS — продакшен + локальная разработка
ALLOWED_ORIGINS=https://clickjurist.ru,https://www.clickjurist.ru,http://localhost:5173
